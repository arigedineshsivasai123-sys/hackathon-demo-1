# Port for Express API server
PORT=5000

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# PostgreSQL Database URL (compatible with Replit PostgreSQL, Neon, Supabase, etc.)
# If left empty, the application uses an automatic local persistent SQL storage engine.
DATABASE_URL=

# JWT Secret for user session signing
JWT_SECRET=agri-advisory-jwt-secret-secure-key-2025

# Node Environment
NODE_ENV=development
